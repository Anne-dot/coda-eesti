---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Materjalid - CODA Eesti">
  <section class="py-16 px-4 min-h-[60vh] flex items-center justify-center">
    <div class="container mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-bold mb-6">Taastumismaterjalid</h1>
      <p class="text-xl text-muted-foreground mb-8">
        Tulekul
      </p>
      <p class="text-muted-foreground">
        Siia lehele lisame lubadused, kogemuslood, traditsioonid ja muud
        taastumismaterjalid.
      </p>
    </div>
  </section>
</Layout>
