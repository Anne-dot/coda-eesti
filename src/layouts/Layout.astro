---
import "../styles/global.css";
import { Astronav, MenuItems, MenuIcon, OpenIcon, CloseIcon } from "astro-navbar";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="et">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CoDA Eesti - Anonüümsed kaassõltlased" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="font-['Roboto',sans-serif] bg-background text-foreground">
    <!-- Header -->
    <header class="bg-background text-foreground sticky top-0 z-50">
      <Astronav closeOnClick>
        <nav class="container mx-auto px-4 py-4 md:py-6">
          <div class="flex w-full items-center justify-between">
            <a href="/" class="text-xl md:text-2xl font-bold">CoDA Eesti</a>

            <div class="block md:hidden">
              <MenuIcon class="w-6 h-6 text-foreground">
                <OpenIcon>
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                  </svg>
                </OpenIcon>
                <CloseIcon>
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </CloseIcon>
              </MenuIcon>
            </div>

            <MenuItems class="hidden md:flex md:gap-6 md:items-center">
              <ul class="flex flex-col md:flex-row md:gap-6 mt-4 md:mt-0">
                <li><a href="/" class="block py-2 hover:opacity-80">Avaleht</a></li>
                <li><a href="/materjalid" class="block py-2 hover:opacity-80">Materjalid</a></li>
                <li><a href="/ressursid" class="block py-2 hover:opacity-80">Ressursid</a></li>
              </ul>
            </MenuItems>
          </div>
        </nav>
      </Astronav>
      <!-- Accent stripe -->
      <div class="flex h-1">
        <div class="flex-1 bg-[#f97316]"></div>
        <div class="flex-1 bg-[#2563eb]"></div>
        <div class="flex-1 bg-[#10b981]"></div>
        <div class="flex-1 bg-[#8b5cf6]"></div>
        <div class="flex-1 bg-[#f97316]"></div>
        <div class="flex-1 bg-[#2563eb]"></div>
        <div class="flex-1 bg-[#10b981]"></div>
        <div class="flex-1 bg-[#8b5cf6]"></div>
      </div>
    </header>

    <!-- Main content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-muted text-muted-foreground py-8 mt-16">
      <div class="container mx-auto px-4 text-center">
        <p class="mb-2">CoDA Eesti - Anonüümsed kaassõltlased</p>
        <p class="text-sm mb-2">
          <a href="https://coda.org" target="_blank" rel="noopener" class="hover:underline">coda.org</a>
        </p>
        <p class="text-xs text-muted-foreground/70">
          Viimati uuendatud: veebruar 2026
        </p>
      </div>
    </footer>
  </body>
</html>
